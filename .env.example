# ==============================================================================
# CloudOps AI - Environment Configuration Variables (.env)
# ==============================================================================

# Platform Application Settings
PROJECT_NAME="CloudOps AI - DevOps Automation Platform"
PROJECT_ID="DEVOPS-001"
ENVIRONMENT="production"
PORT=8000
DEMO_MODE=false

# PostgreSQL Database (Required for Production & Docker Compose)
DATABASE_URL=postgresql://devops_user:devops_password@localhost:5432/devops_db
POSTGRES_DB=devops_db
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_password

# Google Gemini AI Integration (Required for Real-time AI Log Diagnosis)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# AWS Cloud Infrastructure Settings (us-east-1)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/GitHubActions-EKS-Deployer-Role
AWS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
EKS_CLUSTER_NAME=eks-prod-cluster

# Optional Static AWS Access Keys (Recommended: Use AWS IAM OIDC in CI/CD instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Kubernetes Configuration
KUBECONFIG=~/.kube/config
USE_MINIKUBE=false

# Monitoring Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
